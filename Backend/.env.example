SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key

# Live Mode (Apple Watch via Pulsoid)
PULSOID_ACCESS_TOKEN=your-pulsoid-access-token
PULSOID_ENABLED=false
LIVE_MAX_SESSION_MIN=90

# Post-interview analysis server (ai-service/), started separately on port 8001
AI_SERVICE_URL=http://127.0.0.1:8001
AI_SERVICE_TIMEOUT_S=600
